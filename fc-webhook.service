[Unit]
Description=FC-Advisor Webhook Server
After=network.target

[Service]
Type=simple
User=tely
WorkingDirectory=/home/tely/fc-advisor
EnvironmentFile=/home/tely/fc-advisor/.env
ExecStart=/usr/bin/python3 /home/tely/fc-advisor/webhook_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
